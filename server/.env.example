PORT=5000
MONGODB_URI=mongodb://localhost:27017/toyverse
# REQUIRED: a long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Admin account created by `npm run seed`
ADMIN_EMAIL=admin@toyverse.com
ADMIN_PASSWORD=ChangeThisPassword123

# Optional
# CLIENT_URL=http://localhost:5173     # allowed website origin(s) for CORS, comma separated (unset = any)
# SERVER_URL=https://api.example.com   # public address used in uploaded-image URLs (default: the request host)
# LOW_STOCK_LIMIT=5                    # a product with this many units or fewer is flagged low stock
# MONGODB_URI_TEST=mongodb://localhost:27017/toyverse_test   # used only by `npm test` (it is wiped!)
